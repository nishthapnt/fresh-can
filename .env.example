# n8n is fully retired — blog, image_post, video, and social all run on
# Inngest now (src/inngest/functions/**, triggered from
# src/app/api/jobs/[jobId]/{blog,image,video}/** and
# src/app/api/social/post/route.ts). No N8N_* env vars remain.

# Blog + image_post providers, and the image_post clarifying-questions step
# (see src/server/pipeline/env.ts)
OPENAI_API_KEY=
KIE_API_KEY=

# Video providers (see src/server/pipeline/adapters/{elevenlabs,assemblyai,avMerger}.ts)
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
UPLOAD_POST_API_KEY=

# Social posting (src/server/pipeline/adapters/socialPublisher.ts).
# UPLOAD_POST_PROFILE is the upload-post.com profile ("user" in their API)
# that owns the connected Instagram/Facebook/X accounts.
UPLOAD_POST_PROFILE=

