# N8N Webhooks — social is the only content type left on n8n. blog,
# image_post, and video generation, plus the image_post clarifying-questions
# step, no longer go through n8n at all (see worker/,
# src/app/api/jobs/[jobId]/{blog,image,video}/) — N8N_BLOG_WEBHOOK,
# N8N_BLOG_APPROVE_WEBHOOK, N8N_IMAGE_WEBHOOK, N8N_VIDEO_WEBHOOK,
# N8N_VIDEO_APPROVE_WEBHOOK, N8N_VIDEO_APPROVE_BOTH_WEBHOOK, and
# N8N_IMAGE_QUESTIONS_WEBHOOK are all retired.
N8N_SOCIAL_WEBHOOK=<n8n social-post webhook URL>

# Shared secret sent as x-n8n-secret header to n8n
N8N_WEBHOOK_SECRET=<shared secret configured in n8n>

# Blog + image_post worker providers, and the image_post clarifying-questions
# step (see worker/src/env.ts)
OPENAI_API_KEY=
KIE_API_KEY=

# Video worker providers (n8n held these internally before; the worker now
# calls them directly, see worker/src/adapters/{elevenlabs,assemblyai,avMerger}.ts)
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
UPLOAD_POST_API_KEY=

# Social posting (worker/src/adapters/socialPublisher.ts) — replaces n8n's
# social branch. UPLOAD_POST_PROFILE is the upload-post.com profile ("user"
# in their API) that owns the connected Instagram/Facebook/X accounts.
UPLOAD_POST_PROFILE=
